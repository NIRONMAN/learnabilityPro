# ==============================================================================
# Learnability Pro - Backend Environment Variables (.env.example)
# Copy this file to .env or export these variables in your shell / Docker.
# ==============================================================================

# Server Port
PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For Local H2 (in-memory mode, default):
# DATABASE_URL=jdbc:h2:mem:learnability;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# DATABASE_USER=sa
# DATABASE_PASSWORD=
# HIBERNATE_DDL_AUTO=update
# FLYWAY_ENABLED=false

# For PostgreSQL / Supabase with pgvector:
DATABASE_URL=jdbc:postgresql://localhost:5432/learnability
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# Google GenAI / Gemini API Configuration
# ------------------------------------------------------------------------------
GEMINI_PROJECT_ID=learnability-pro-dev
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# Spring AI Vector Store Configuration
# ------------------------------------------------------------------------------
# Leave empty when using real PostgreSQL with pgvector extension.
# Set to 'org.springframework.ai.vectorstore.pgvector.autoconfigure.PgVectorStoreAutoConfiguration'
# to disable pgvector autoconfiguration and fall back to in-memory SimpleVectorStore (e.g. for H2 local dev).
SPRING_AUTOCONFIGURE_EXCLUDE=

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# 256-bit or 512-bit hex secret key for HMAC-SHA signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Token validity duration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000
