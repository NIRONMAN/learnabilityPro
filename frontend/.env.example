# ==============================================================================
# Learnability Pro - Frontend Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# ==============================================================================

# Backend API server URL used for Next.js API rewrites (/api/* -> BACKEND_URL/api/*)
BACKEND_URL=http://localhost:8080

# Public URL of the frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port for Next.js dev server (default: 3000)
PORT=3000
